  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "// ": "using pm2 takes advantage of all cores of the machine to run the application. since nodejs is single-threaded, it is best to use pm2 to run the application.",
    "// -i 5": "use 5 processes of the machine to run the application.",
    "start": "pm2 start ./build/src/app.js -i 5 --attach --watch | pino-pretty -c",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "lint:check": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier 'src/**/*.{ts,json}' --check",
    "prettier:fix": "prettier 'src/**/*.{ts,json}' --write",
    "dev": "nodemon -r tsconfig-paths/register src/app.ts | pino-pretty -c",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@ask4o2/jobber-shared": "^0.0.4",
    "@elastic/elasticsearch": "^9.5.1",
    "@faker-js/faker": "^10.6.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "redis": "^6.3.0",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
